{
  "manifest_version": 3,
  "name": "PhishCatcher",
  "version": "1.0.0",
  "description": "Real-time phishing website detection using URL and webpage security features.",
  
  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extractors/urlFeatures.js",
        "extractors/htmlFeatures.js",
        "extractors/tldParser.js",
        "extractors/entropy.js",
        "extractors/keywordDetector.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}